# ============================================================
# DYNAMIC PRICING ENGINE — .gitignore (DEPLOYMENT VERSION)
# ============================================================

# ── Python ──
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/

# ── Virtual Environment ──
venv/
env/
ENV/
.venv/

# ── Jupyter ──
.ipynb_checkpoints/
*.ipynb

# ── IDE ──
.vscode/settings.json
.idea/
*.swp

# ── OS Files ──
.DS_Store
Thumbs.db

# ── Environment Variables ──
.env

# ── Logs ──
*.log

# NOTE: We DO include models/*.pkl and data/*.csv
# because Streamlit Cloud needs them to run the app.
# They are generated locally and pushed to GitHub.